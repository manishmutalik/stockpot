# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shopify Integration
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Used to sign/parse cookies (currently only the CSRF cookie — no secrets are
# stored in cookies anymore).
COOKIE_SECRET=

# Required: encrypts Shopify/Odoo credentials before they're stored in
# Firestore (see lib/integrationStore.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# Required for the server to verify Firebase ID tokens (see lib/auth.ts).
# Option A: point this at a downloaded service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B (e.g. on platforms where you can't mount a file): paste the full
# service account JSON as a single-line string here instead of using
# GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Billing (Stripe) ---
# Required to enable subscriptions. Without these, the server still boots
# and every non-billing route works normally — only the billing routes and
# the in-app paywall gate fail, with a clear "not configured" error.
#
# Temporary testing toggle: set to "true" to give every signed-in user full
# access without any Stripe setup at all — the paywall never shows, and the
# checkout/portal routes return a clear "temporarily disabled" error if
# somehow reached. Remove this (or set to anything else) to re-enable real
# billing — no other code changes needed.
BILLING_DISABLED=
#
# Secret API key, from https://dashboard.stripe.com/apikeys
# (use a test-mode key, starting with sk_test_, while developing).
STRIPE_SECRET_KEY=
#
# The Price ID for your subscription plan, from
# https://dashboard.stripe.com/products (create a recurring price first).
# Looks like price_1AbCDeFGhIJKlmNoPQrSTuv.
STRIPE_PRICE_ID=
#
# Webhook signing secret, from the endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at
# {APP_URL}/api/billing/webhook. Subscribe it to at least:
# checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=
