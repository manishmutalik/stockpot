# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shopify Integration
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# USDA FoodData Central API key (free), from https://fdc.nal.usda.gov/api-key-signup.html
# Used by the "Look up" nutrition search on the Inventory tab. Without it,
# the app still boots and works normally — only that one search source
# returns a "not configured" error (Open Food Facts, queried alongside it,
# needs no key at all).
USDA_API_KEY=

# Used to sign/parse cookies (currently only the CSRF cookie — no secrets are
# stored in cookies anymore).
COOKIE_SECRET=

# Required: encrypts Shopify/Odoo credentials before they're stored in
# Firestore (see lib/integrationStore.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENC_KEY=

# Required for the server to verify Firebase ID tokens (see lib/auth.ts).
# Option A: point this at a downloaded service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Option B (e.g. on platforms where you can't mount a file): paste the full
# service account JSON as a single-line string here instead of using
# GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Billing (Razorpay) ---
# Required to enable subscriptions. Without these, the server still boots
# and every non-billing route works normally — only the billing routes and
# the in-app paywall gate fail, with a clear "not configured" error.
#
# Temporary testing toggle: set to "true" to give every signed-in user full
# access without any Razorpay setup at all — the billing routes return a clear
# "temporarily disabled" error if somehow reached. Remove this (or set to
# anything else) to re-enable real billing — no other code changes needed.
BILLING_DISABLED=
#
# API keys, from https://dashboard.razorpay.com/app/keys. Use the Test Mode
# keys (Key Id starts with rzp_test_) while developing, and the Live Mode keys
# once the account is activated. The Key Id is public (the browser needs it to
# open checkout); the Key Secret must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# The Plan the customer subscribes to: a monthly plan in INR, created at
# https://dashboard.razorpay.com/app/subscriptions/plans. Looks like
# plan_AbCdEfGhIjKlMn. Test Mode and Live Mode have separate plans.
RAZORPAY_PLAN_ID=
#
# Webhook secret: you choose it when you add the webhook at
# https://dashboard.razorpay.com/app/webhooks, pointing at
# {APP_URL}/api/billing/webhook. Subscribe it to the subscription events
# (authenticated, activated, charged, pending, halted, cancelled, completed,
# paused, resumed).
RAZORPAY_WEBHOOK_SECRET=
