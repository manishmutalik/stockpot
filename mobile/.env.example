# The Stockpot server the app talks to (no trailing slash). In development this is your local server or the deployed one.
EXPO_PUBLIC_API_URL=https://your-stockpot-server.example.com

# The "Web client ID" of Firebase's Google sign-in method (Firebase console, Authentication, Sign-in method, Google). It
# switches on "Continue with Google" on Android; leave it out and the button is not shown. See README.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
